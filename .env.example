# Local development (task dev / ./bin/athenaeum). Flags override these; shell exports override .env.
ATHENAEUM_ADDR=:8080
ATHENAEUM_DATA=./data
ATHENAEUM_LIBRARY=./library
ATHENAEUM_UPLOAD_MAX_BYTES=2147483648

# Database: sqlite (default) or postgres
# ATHENAEUM_DATABASE_DRIVER=sqlite
# ATHENAEUM_DATABASE_URL=postgres://athenaeum:athenaeum@127.0.0.1:5432/athenaeum?sslmode=disable

# Optional: serve a built SPA from disk instead of the binary-embedded assets
# ATHENAEUM_WEB_DIR=./internal/assets/dist

# Bootstrap first admin when no users exist (optional)
# ATHENAEUM_ADMIN_USER=admin
# ATHENAEUM_ADMIN_PASS=change-me-now

# Optional alternate dotenv path
# ATHENAEUM_ENV_FILE=/path/to/.env

# ATHENAEUM_SCAN_WORKERS=2

# Logging
# ATHENAEUM_LOG_LEVEL=info
# ATHENAEUM_LOG_FILE=./data/athenaeum.log
# ATHENAEUM_DEBUG=false

# Optional loopback-only pprof HTTP server (local profiling)
# ATHENAEUM_PPROF=127.0.0.1:6060

# CLI color: auto | always | never (also honors NO_COLOR / FORCE_COLOR)
# ATHENAEUM_COLOR=auto
# ATHENAEUM_NO_COLOR=false

# Linux sandbox (Landlock filesystem + seccomp-bpf denylist): off | try | strict
# Default is try. Compose also defaults to try. Set off to disable.
# ATHENAEUM_SANDBOX=try
# ATHENAEUM_SANDBOX_LANDLOCK=true
# ATHENAEUM_SANDBOX_SECCOMP=true

# Sentry or GlitchTip error reporting (optional; same DSN format for both)
# ATHENAEUM_SENTRY_DSN=https://key@glitchtip.example.com/1
# ATHENAEUM_SENTRY_DSN_PUBLIC=https://key@glitchtip.example.com/1
# ATHENAEUM_SENTRY_ENVIRONMENT=production
# ATHENAEUM_SENTRY_RELEASE=athenaeum@0.1.0
# ATHENAEUM_SENTRY_TRACES_SAMPLE_RATE=0

# Optional ALTCHA (privacy-first PoW captcha). Off by default.
# Docs: https://altcha.org/docs/  Widget: https://altcha.org/docs/integration/widget/
# ATHENAEUM_ALTCHA_ENABLED=true
# ATHENAEUM_ALTCHA_MODE=builtin
# ATHENAEUM_ALTCHA_HMAC_SECRET=
# ATHENAEUM_ALTCHA_HMAC_KEY_SECRET=
# ATHENAEUM_ALTCHA_CHALLENGE_URL=
# ATHENAEUM_ALTCHA_SENTINEL_URL=
# ATHENAEUM_ALTCHA_VERIFY_URL=
# ATHENAEUM_ALTCHA_API_KEY_SECRET=
# ATHENAEUM_ALTCHA_COST=5000
# ATHENAEUM_ALTCHA_EXPIRES=300
# ATHENAEUM_ALTCHA_PROTECT=login,setup
# ATHENAEUM_ALTCHA_WIDGET_AUTO=onsubmit
# ATHENAEUM_ALTCHA_WIDGET_DISPLAY=standard
# ATHENAEUM_ALTCHA_WIDGET_TYPE=checkbox
# ATHENAEUM_ALTCHA_WIDGET_THEME=auto
# ATHENAEUM_ALTCHA_WIDGET_LANGUAGE=
# ATHENAEUM_ALTCHA_WIDGET_NAME=altcha
# ATHENAEUM_ALTCHA_WIDGET_WORKERS=0
# ATHENAEUM_ALTCHA_WIDGET_HIDE_LOGO=false
# ATHENAEUM_ALTCHA_WIDGET_HIDE_FOOTER=false

# Password strength policy (registration, setup, password changes)
# ATHENAEUM_PASSWORD_MIN_LENGTH=8
# ATHENAEUM_PASSWORD_LONG_LENGTH=12
# ATHENAEUM_PASSWORD_MIN_KINDS=3
# ATHENAEUM_PASSWORD_REQUIRE_LOWER=false
# ATHENAEUM_PASSWORD_REQUIRE_UPPER=false
# ATHENAEUM_PASSWORD_REQUIRE_DIGIT=false
# ATHENAEUM_PASSWORD_REQUIRE_SYMBOL=false

# Used by: athenaeum users reset-password --password ...
# ATHENAEUM_PASSWORD=

# ATHENAEUM_DEMO=true

# Seed a generated demo library (fictional books/audiobooks + covers) on startup
# ATHENAEUM_DEMO=true

# Docker Compose only (host-side; see README "Docker")
# ATHENAEUM_LIBRARY_HOST_PATH=/path/to/your/books
# ATHENAEUM_PUBLISH_PORT=8080
# ATHENAEUM_VERSION=latest
# ATHENAEUM_IMAGE=ghcr.io/quad4-software/athenaeum:latest

# Compose profiles (optional): altcha, kokoro, postgres
# COMPOSE_PROFILES=altcha,kokoro,postgres

# --profile altcha (ALTCHA Sentinel)
# ALTCHA_SENTINEL_VERSION=latest
# ALTCHA_PUBLISH_PORT=8081
# ALTCHA_LICENSE_KEY=
# ALTCHA_SECRET_SEED=

# --profile postgres (also set driver/url)
# ATHENAEUM_DATABASE_DRIVER=postgres
# ATHENAEUM_DATABASE_URL=postgres://athenaeum:athenaeum@postgres:5432/athenaeum?sslmode=disable

# --profile kokoro
# KOKORO_PUBLISH_PORT=8880
# KOKORO_LANG=a
# KOKORO_DEFAULT_VOICE=af_heart
# KOKORO_API_KEY=
