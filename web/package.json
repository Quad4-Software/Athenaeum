{
  "name": "athenaeum-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Frontend for Athenaeum: a single-binary EPUB/PDF library server",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "vite build",
    "build:slim": "VITE_SLIM=1 vite build",
    "build:demo": "VITE_DEMO=1 vite build",
    "preview": "vite preview",
    "preview:demo": "VITE_DEMO=1 vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:property": "vitest run src/lib/utils/property.test.ts",
    "test:mutation": "stryker run",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "showcase": "node ../scripts/showcase-screenshots.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node ../scripts/unused-web.mjs",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "30.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@huggingface/transformers": "4.3.2",
    "@lucide/svelte": "^1.66.0",
    "@sentry/svelte": "^10.75.3",
    "altcha": "^3.5.0",
    "bits-ui": "2.20.3",
    "epubjs": "^0.3.93",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "runed": "0.38.0",
    "workbox-window": "^7.4.1"
  }
}
