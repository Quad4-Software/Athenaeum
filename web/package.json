{
  "name": "athenaeum-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Frontend for Athenaeum: a single-binary EPUB/PDF library server",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "vite build",
    "build:demo": "VITE_DEMO=1 vite build",
    "preview": "vite preview",
    "preview:demo": "VITE_DEMO=1 vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:property": "vitest run src/lib/utils/property.test.ts",
    "test:mutation": "stryker run",
    "test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "showcase": "node ../scripts/showcase-screenshots.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node ../scripts/unused-web.mjs",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.6.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "@sentry/svelte": "^10.71.0",
    "altcha": "^3.2.2",
    "epubjs": "^0.3.93",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^6.2.108",
    "workbox-window": "^7.4.1"
  }
}
