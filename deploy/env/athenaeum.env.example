# Athenaeum service environment.
# Copy to /etc/athenaeum/athenaeum.env and adjust.
# Flags on ExecStart / command line override these.

ATHENAEUM_ADDR=0.0.0.0:8080
ATHENAEUM_DATA=/var/lib/athenaeum/data
ATHENAEUM_LIBRARY=/var/lib/athenaeum/library
ATHENAEUM_UPLOAD_MAX_BYTES=2147483648
ATHENAEUM_LOG_LEVEL=info
ATHENAEUM_COLOR=never

# Database: sqlite (default file under ATHENAEUM_DATA) or postgres
# ATHENAEUM_DATABASE_DRIVER=sqlite
# ATHENAEUM_DATABASE_URL=postgres://athenaeum:athenaeum@127.0.0.1:5432/athenaeum?sslmode=disable

# Optional first-admin bootstrap (only when no users exist)
# ATHENAEUM_ADMIN_USER=admin
# ATHENAEUM_ADMIN_PASS=change-me-now

# Optional sandbox on Linux: off | try | strict
# ATHENAEUM_SANDBOX=try
