{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Athenaeum server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/athenaeum",
      "cwd": "${workspaceFolder}",
      "args": ["--addr", ":8080", "--library", "./library", "--data", "./data"],
      "env": {
        "ATHENAEUM_DEBUG": "true"
      }
    },
    {
      "name": "Athenaeum server (demo)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/athenaeum",
      "cwd": "${workspaceFolder}",
      "args": ["--addr", ":8080", "--library", "./library", "--data", "./data", "--demo"]
    },
    {
      "name": "Athenaeum server (pprof)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/athenaeum",
      "cwd": "${workspaceFolder}",
      "args": [
        "--addr",
        ":8080",
        "--library",
        "./library",
        "--data",
        "./data",
        "--pprof",
        "127.0.0.1:6060"
      ]
    },
    {
      "name": "Vite frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Athenaeum server", "Vite frontend"],
      "stopAll": true
    }
  ]
}
